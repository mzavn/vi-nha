{
  "name": "vi-nha",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "build": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "specs:gen": "python3 .claude/skills/mk-specs/scripts/gen.py",
    "specs:check": "python3 .claude/skills/mk-specs/scripts/verify.py",
    "check:private": "node scripts/check-private.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.8",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.136.1"
  },
  "engines": {
    "node": ">=22.13"
  },
  "cloudflare": {
    "bindings": {
      "APP_PASSWORD": {
        "description": "Mật khẩu chung của cả nhà: dùng ở màn Thiết lập lần đầu và để đăng nhập. Đặt dài, khó đoán, ghi lại ngay."
      }
    }
  }
}
